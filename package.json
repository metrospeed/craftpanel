  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "smol-toml": "^1.3.1",
    "tar": "^7.4.3",
    "ws": "^8.18.0",
    "yaml": "^2.6.1"
  }
}
